			"contents": "/*\n * vfs_depth_probe.c — Safe VFS depth tracing using verified offsets\n *\n * This module traces link_path_walk and walk_component safely by using\n * hardcoded byte offsets verified via pahole/BTF, rather than relying on\n * struct definitions that are subject to __randomize_layout.\n *\n * Verified offsets for kernel 6.17.0-14-generic:\n *   offset 0x08: path.dentry      [struct dentry *]\n *   offset 0x18: last.name        [const char *]\n *   offset 0x30: inode            [struct inode *]\n *   offset 0x38: flags            [unsigned int]\n *   offset 0x54: depth            [unsigned int]\n */\n\n#include <linux/dcache.h>\n#include <linux/fs.h>\n#include <linux/kernel.h>\n#include <linux/kprobes.h>\n#include <linux/module.h>\n#include <linux/uaccess.h>\n\nMODULE_LICENSE(\"GPL\");\nMODULE_DESCRIPTION(\"Safe VFS depth probe using verified offsets\");\n\nstatic char target_comm[TASK_COMM_LEN] = \"\";\nmodule_param_string(target_comm, target_comm, sizeof(target_comm), 0644);\n\n/* Verified byte offsets from pahole/BTF analysis */\n#define OFF_PATH_DENTRY  0x08   /* nd->path.dentry */\n#define OFF_LAST_NAME    0x18   /* nd->last.name */\n#define OFF_INODE        0x30   /* nd->inode */\n#define OFF_FLAGS        0x38   /* nd->flags */\n#define OFF_DEPTH        0x54   /* nd->depth */\n\n/* Safe field extraction using copy_from_kernel_nofault */\nstatic inline int safe_read_ptr(void *dst, void *src)\n{\n    return copy_from_kernel_nofault(dst, src, sizeof(void *));\n}\n\nstatic inline int safe_read_u32(void *dst, void *src)\n{\n    return copy_from_kernel_nofault(dst, src, sizeof(u32));\n}\n\n/* Get dentry name safely - just print pointer, don't dereference string\n * strncpy_from_kernel_nofault not exported in 6.17, so we just show pointer */\nstatic const char *get_dentry_name(struct dentry *d)\n{\n    if (!d)\n        return \"NULL\";\n    return \"(ptr)\";  /* Safe - no string dereference */\n}\n\nstatic int handler_link_path_walk(struct kprobe *p, struct pt_regs *regs)\n{\n    void *nd = (void *)regs->si;\n    struct dentry *parent = NULL;\n    const char *target = NULL;\n    u32 flags = 0, depth = 0;\n    u32 salt = 0; \n\n    \n    /* Filter by process name if specified */\n    if (target_comm[0] && strcmp(current->comm, target_comm) != 0)\n        return 0;\n    \n    /* Safely read nd->path.dentry at offset 0x08 */\n    if (safe_read_ptr(&parent, nd + OFF_PATH_DENTRY) != 0)\n        parent = NULL;\n    \n    /* Safely read nd->last.name at offset 0x18 */\n    if (safe_read_ptr((void *)&target, nd + OFF_LAST_NAME) != 0)\n        target = NULL;\n    \n    /* Safely read nd->flags at offset 0x38 */\n    safe_read_u32(&flags, nd + OFF_FLAGS);\n    \n    /* Safely read nd->depth at offset 0x54 */\n    safe_read_u32(&depth, nd + OFF_DEPTH);\n    \n    safe_read_u32(&salt, (void*)parent + 32 );\n    u32 h = salt; \n    while ( target && *target) {\n        \n    }\n    pr_info(\"[LPW] Parent=%s Target=%s flags=0x%x depth=%u\\n\",\n            get_dentry_name(parent),\n            target ? target : \"NULL\",\n            flags, depth);\n    \n    return 0;\n}\n\nstatic int handler_walk_component(struct kprobe *p, struct pt_regs *regs)\n{\n    void *nd = (void *)regs->di;\n    struct dentry *parent = NULL;\n    const char *target = NULL;\n    u32 depth = 0;\n    int wc_flags = (int)regs->si;\n    \n    /* Filter by process name if specified */\n    if (target_comm[0] && strcmp(current->comm, target_comm) != 0)\n        return 0;\n    \n    /* Safely read nd->path.dentry at offset 0x08 */\n    if (safe_read_ptr(&parent, nd + OFF_PATH_DENTRY) != 0)\n        parent = NULL;\n    \n    /* Safely read nd->last.name at offset 0x18 */\n    if (safe_read_ptr((void *)&target, nd + OFF_LAST_NAME) != 0)\n        target = NULL;\n    \n    /* Safely read nd->depth at offset 0x54 */\n    safe_read_u32(&depth, nd + OFF_DEPTH);\n    \n    pr_info(\"[WC]  Parent=%s Target=%s wc_flags=0x%x depth=%u\\n\",\n            get_dentry_name(parent),\n            target ? target : \"NULL\",\n            wc_flags, depth);\n    \n    return 0;\n}\n\nstatic struct kprobe kp_link_path = {\n    .symbol_name = \"link_path_walk\",\n    .pre_handler = handler_link_path_walk,\n};\n\nstatic struct kprobe kp_walk_comp = {\n    .symbol_name = \"walk_component\",\n    .pre_handler = handler_walk_component,\n};\n\nstatic int __init vfs_depth_init(void)\n{\n    int ret;\n    \n    ret = register_kprobe(&kp_link_path);\n    if (ret < 0) {\n        pr_err(\"vfs_depth_probe: failed to register link_path_walk probe: %d\\n\", ret);\n        return ret;\n    }\n    \n    ret = register_kprobe(&kp_walk_comp);\n    if (ret < 0) {\n        unregister_kprobe(&kp_link_path);\n        pr_err(\"vfs_depth_probe: failed to register walk_component probe: %d\\n\", ret);\n        return ret;\n    }\n    \n    pr_info(\"vfs_depth_probe: loaded. target_comm=%s\\n\", \n            target_comm[0] ? target_comm : \"(all)\");\n    return 0;\n}\n\nstatic void __exit vfs_depth_exit(void)\n{\n    unregister_kprobe(&kp_walk_comp);\n    unregister_kprobe(&kp_link_path);\n    pr_info(\"vfs_depth_probe: unloaded\\n\");\n}\n\nmodule_init(vfs_depth_init);\nmodule_exit(vfs_depth_exit);\n",
